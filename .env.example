# ============================================================
# Mem0 Unified Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in the values.
# This file is used by:
#   - server/              (Mem0 REST API + Dashboard)
#   - openmemory/api/      (OpenMemory MCP API)
#   - openmemory/ui/       (OpenMemory Web UI)
#   - docker-compose files
# ============================================================

# ------------------------------------------------------------
# 1. Core / Shared Settings
# ------------------------------------------------------------

# Environment: development | staging | production
ENV=development

# Anonymous telemetry. Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep (server only)
REQUEST_LOG_RETENTION_DAYS=30

# ------------------------------------------------------------
# 2. PostgreSQL Database (shared by server and openmemory)
# ------------------------------------------------------------
# Server uses two databases:
#   - POSTGRES_DB (default: postgres)   -> pgvector memory storage
#   - MEM0_APP_DB_NAME (default: mem0_app) -> users/auth/api keys
# OpenMemory uses DATABASE_URL or the individual POSTGRES_* vars.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

# Server app database (users/auth/api keys)
MEM0_APP_DB_NAME=mem0_app

# OpenMemory SQLite fallback (used only when no Postgres configured)
# DATABASE_URL=sqlite:///./openmemory.db

# ------------------------------------------------------------
# 3. Authentication (server only)
# ------------------------------------------------------------

# JWT secret — generate with: openssl rand -base64 48
# Required unless AUTH_DISABLED=true
JWT_SECRET=

# Admin API key (legacy, bypasses user table)
# Recommended length >= 16 chars
ADMIN_API_KEY=

# Disable authentication — LOCAL DEVELOPMENT ONLY
AUTH_DISABLED=false

# ------------------------------------------------------------
# 4. LLM Provider API Keys
# ------------------------------------------------------------

# OpenAI (default provider)
OPENAI_API_KEY=

# Optional providers (uncomment and set as needed)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=

# ------------------------------------------------------------
# 5. Default LLM & Embedder Models
# ------------------------------------------------------------

MEM0_LLM_PROVIDER=openai
MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14
MEM0_EMBEDDER_PROVIDER=openai
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Ollama (optional)
# OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# 6. Vector Store
# ------------------------------------------------------------
# Choose ONE vector store provider.
# Server defaults to pgvector (uses Postgres above).
# OpenMemory defaults to qdrant.

# pgvector (server default)
# Uses POSTGRES_* variables above.
VECTOR_STORE_PROVIDER=pgvector

# Qdrant (openmemory default)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Redis
# REDIS_URL=redis://localhost:6379

# Weaviate
# WEAVIATE_HOST=localhost
# WEAVIATE_PORT=8080

# Milvus
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Chroma
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Elasticsearch / OpenSearch
# ELASTICSEARCH_HOST=localhost
# ELASTICSEARCH_PORT=9200
# ELASTICSEARCH_USER=elastic
# ELASTICSEARCH_PASSWORD=changeme

# FAISS (local file-based, no service needed)
# FAISS_PATH=/tmp/faiss

# ------------------------------------------------------------
# 7. Service URLs & CORS
# ------------------------------------------------------------

# Server dashboard URL (for CORS)
DASHBOARD_URL=http://localhost:3000

# OpenMemory — public API URL (UI connects to this)
NEXT_PUBLIC_API_URL=http://localhost:8765

# OpenMemory — internal API URL (container-to-container)
API_INTERNAL_URL=http://openmemory-mcp:8765

# Mem0 server dashboard — public API URL
NEXT_PUBLIC_MEM0_API_URL=http://localhost:8888

# Instance name shown in UI
NEXT_PUBLIC_INSTANCE_NAME=Mem0

# ------------------------------------------------------------
# 8. User Identity (openmemory)
# ------------------------------------------------------------

MEM0_USER_ID=default_user

# ------------------------------------------------------------
# 9. Container Ports (override if you have conflicts)
# ------------------------------------------------------------

# Mem0 server REST API
MEM0_SERVER_PORT=8888
# Mem0 server Dashboard
MEM0_DASHBOARD_PORT=3000
# OpenMemory MCP API
OPENMEMORY_API_PORT=8765
# OpenMemory Web UI
OPENMEMORY_UI_PORT=3001
# Postgres exposed port
POSTGRES_EXPOSE_PORT=5432
# Qdrant exposed port
QDRANT_EXPOSE_PORT=6333
