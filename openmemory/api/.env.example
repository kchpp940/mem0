# ============================================================
# OpenMemory API — see ../../.env.example for the full reference.
# ============================================================
# This file is a subset. The canonical source of truth is the
# .env.example at the repository root. For local development we
# recommend copying ../../.env.example to ../../.env and editing
# there; the API will auto-detect and load the parent .env.
#
# Quick start (from repo root):
#   cp .env.example .env
#   # edit .env to fill in OPENAI_API_KEY and vector store settings
#   cd openmemory && docker compose up
# ============================================================

# ---- Required ------------------------------------------------
OPENAI_API_KEY=

# ---- User identity ------------------------------------------
MEM0_USER_ID=default_user
# Legacy alias still supported:
# USER=default_user

# ---- LLM / Embedder -----------------------------------------
# MEM0_LLM_PROVIDER=openai
# MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14
# MEM0_EMBEDDER_PROVIDER=openai
# MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Ollama (optional)
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Vector store (pick ONE) --------------------------------
VECTOR_STORE_PROVIDER=qdrant

# Qdrant (default for openmemory)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# pgvector (uses POSTGRES_* below)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=

# Redis
# REDIS_URL=redis://localhost:6379

# Weaviate
# WEAVIATE_HOST=localhost
# WEAVIATE_PORT=8080

# Milvus
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Chroma
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Elasticsearch / OpenSearch
# ELASTICSEARCH_HOST=localhost
# ELASTICSEARCH_PORT=9200
# ELASTICSEARCH_USER=elastic
# ELASTICSEARCH_PASSWORD=changeme

# FAISS (local file, no service required)
# FAISS_PATH=/tmp/faiss

# ---- Database (optional, defaults to SQLite) ----------------
# Either use individual Postgres vars (above) or a full URL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/openmemory
# DATABASE_URL=sqlite:///./openmemory.db
