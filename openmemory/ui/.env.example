# ============================================================
# OpenMemory UI — see ../../.env.example for the full reference.
# ============================================================
# Next.js build-time variables (prefixed with NEXT_PUBLIC_):
#   - Read at `pnpm build` time and inlined into the client bundle.
#   - Overridden at container start by entrypoint.sh (see that file).

# Public API URL the browser uses to reach the OpenMemory API
NEXT_PUBLIC_API_URL=http://localhost:8765

# Default user ID shown in the UI
NEXT_PUBLIC_USER_ID=default_user

# (Optional) Internal API URL the Next.js server uses to reach the API
# API_INTERNAL_URL=http://openmemory-mcp:8765
