# ============================================================
# Mem0 Server — see ../.env.example for the full reference.
# ============================================================
# This file is a subset. The canonical source of truth is the
# .env.example at the repository root. For local development we
# recommend copying ../.env.example to ../.env and editing there;
# the server will auto-detect and load the parent .env.
#
# Quick start (from repo root):
#   cp .env.example .env
#   # edit .env to fill in POSTGRES_PASSWORD, OPENAI_API_KEY, JWT_SECRET
#   cd server && docker compose up
# ============================================================

# ---- Required ------------------------------------------------
POSTGRES_PASSWORD=
OPENAI_API_KEY=
JWT_SECRET=

# ---- Optional (shown with defaults) -------------------------
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_COLLECTION_NAME=memories
# MEM0_APP_DB_NAME=mem0_app

# ADMIN_API_KEY=
# AUTH_DISABLED=false

# MEM0_LLM_PROVIDER=openai
# MEM0_DEFAULT_LLM_MODEL=gpt-4.1-nano-2025-04-14
# MEM0_EMBEDDER_PROVIDER=openai
# MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# DASHBOARD_URL=http://localhost:3000
# MEM0_TELEMETRY=true
# REQUEST_LOG_RETENTION_DAYS=30
