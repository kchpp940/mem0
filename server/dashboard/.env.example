# ============================================================
# Mem0 Server Dashboard — see ../../.env.example for the full reference.
# ============================================================
# Next.js build-time variables (prefixed with NEXT_PUBLIC_):
#   - Read at `pnpm build` time and inlined into the client bundle.
#   - Overridden at container start by entrypoint.sh (see that file).
#
# Next.js server-only variables (no NEXT_PUBLIC_ prefix):
#   - Read by the Node server at runtime.

# URL the browser uses to reach the Mem0 REST API
NEXT_PUBLIC_API_URL=http://localhost:8888

# URL the Next.js server uses to reach the Mem0 REST API (container-internal)
API_INTERNAL_URL=http://localhost:8888

# Display name shown in the UI header
NEXT_PUBLIC_INSTANCE_NAME=Mem0
